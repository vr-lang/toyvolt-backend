# ==========================================
# Toyvolt Backend Environment Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5001

# MongoDB Database URI (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/toyvolt?retryWrites=true&w=majority

# Allowed Frontend Origins for CORS
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# Authentication & Security
COOKIE_NAME=toyvolt_access_token
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_another_secure_random_secret_for_refresh
REFRESH_TOKEN_EXPIRES_IN=7d

# Resend API (Transactional Email & OTP)
# Get your API key at: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Cloudinary (Product Media Storage)
# Get credentials at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Payments)
# Get keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket (Shipping & Logistics)
# Account credentials from: https://app.shiprocket.in
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
SHIPROCKET_PICKUP_LOCATION=Primary
